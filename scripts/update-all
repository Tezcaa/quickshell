#!/bin/bash

# Update all packages: pacman/AUR (yay) + Flatpak.
# Warns if the kernel was updated and a reboot is needed.

set -o pipefail

# Packages to skip during the upgrade. heroic-games-launcher pulls in
# nodejs-lts-krypton as a make-dep, which conflicts with the installed nodejs
# (required by stremio-linux-shell) and aborts the whole transaction.
# Add space-separated package names here to exclude them.
IGNORE_PKGS="heroic-games-launcher"

# Acquire sudo credentials up front, in this terminal, so the later
# yay/pacman calls don't fail with "sudo: a terminal is required" when the
# script is launched detached (e.g. from quickshell via ghostty -e).
echo -e "\e[32m==> Authenticating (sudo)...\e[0m"
if ! sudo -v; then
  echo -e "\e[31mFailed to obtain sudo credentials. Aborting.\e[0m"
  read -r -p "Press Enter to close."
  exit 1
fi
# Keep the sudo timestamp fresh while the (possibly long) update runs.
( while true; do sudo -n true; sleep 60; done ) &
sudo_keepalive_pid=$!
trap 'kill "$sudo_keepalive_pid" 2>/dev/null' EXIT

# Build the --ignore argument list from IGNORE_PKGS.
ignore_args=()
for p in $IGNORE_PKGS; do
  ignore_args+=(--ignore "$p")
done

echo -e "\e[32m==> Updating system packages (pacman + AUR)...\e[0m"
if command -v yay >/dev/null 2>&1; then
  # --removemake: clean build deps; --answer* skip yay's interactive menus;
  # --noconfirm: skip the pacman "packages to exclude" / confirmation prompts.
  yay -Syu --noconfirm --removemake --answerclean All --answerdiff None "${ignore_args[@]}"
else
  sudo pacman -Syu --noconfirm "${ignore_args[@]}"
fi

if command -v flatpak >/dev/null 2>&1; then
  echo -e "\n\e[32m==> Updating Flatpaks...\e[0m"
  flatpak update -y
fi

# --- Reboot check: compare running kernel to the installed one ---
# Detect which kernel package is installed and its pkgver.
kernel_pkg=""
for k in linux linux-lts linux-zen linux-hardened linux-cachyos; do
  if pacman -Q "$k" >/dev/null 2>&1; then
    kernel_pkg="$k"
    break
  fi
done

if [[ -n $kernel_pkg ]]; then
  running="$(uname -r)"
  # Installed version, e.g. "7.1.4.arch1-1"; normalize to compare loosely.
  installed="$(pacman -Q "$kernel_pkg" | awk '{print $2}')"
  # Extract the numeric version prefix from both for a simple mismatch check.
  running_ver="${running%%-*}"                      # 7.1.3
  installed_ver="$(echo "$installed" | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+' )"

  if [[ $running_ver != "$installed_ver" ]]; then
    echo -e "\n\e[1;33m==============================================\e[0m"
    echo -e "\e[1;33m  Kernel updated: running $running_ver -> installed $installed_ver\e[0m"
    echo -e "\e[1;33m  A REBOOT is required to use the new kernel.\e[0m"
    echo -e "\e[1;33m==============================================\e[0m"
  fi
fi

echo -e "\n\e[32mAll done.\e[0m Press Enter to close."
read -r

