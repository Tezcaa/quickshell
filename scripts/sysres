#!/usr/bin/env python3
# Output system resource usage in a simple format:
#   cpu:<percent>
#   ram:<percent>:<used_gb>:<total_gb>
#   gpu:<percent>

import time
import subprocess


def cpu_sample():
    with open('/proc/stat') as f:
        line = f.readline()
    fields = line.split()[1:]
    idle = int(fields[3])
    total = sum(int(x) for x in fields)
    return idle, total


def ram_usage():
    mem = {}
    with open('/proc/meminfo') as f:
        for line in f:
            if ':' in line:
                key, val = line.split(':', 1)
                mem[key.strip()] = int(val.split()[0])
    total_kb = mem.get('MemTotal', 0)
    available_kb = mem.get('MemAvailable', mem.get('MemFree', 0))
    if total_kb == 0:
        return 0.0, 0.0, 0.0
    used_kb = total_kb - available_kb
    total_gb = total_kb / 1024 / 1024
    used_gb = used_kb / 1024 / 1024
    pct = used_kb / total_kb * 100.0
    return pct, used_gb, total_gb


def gpu_usage():
    try:
        out = subprocess.check_output(
            ['nvidia-smi', '--query-gpu=utilization.gpu', '--format=csv,noheader,nounits'],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
        return float(out.strip())
    except Exception:
        return 0.0


idle1, total1 = cpu_sample()
time.sleep(0.5)
idle2, total2 = cpu_sample()

diff_idle = idle2 - idle1
diff_total = total2 - total1
if diff_total <= 0:
    cpu_pct = 0.0
else:
    cpu_pct = (1.0 - diff_idle / diff_total) * 100.0

ram_pct, ram_used, ram_total = ram_usage()

print(f"cpu:{cpu_pct:.1f}")
print(f"ram:{ram_pct:.1f}:{ram_used:.1f}:{ram_total:.1f}")
print(f"gpu:{gpu_usage():.1f}")
